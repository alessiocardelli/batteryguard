/* Italiano. Le chiavi sono i testi inglesi del codice (lingua di sviluppo). */

/* Stato 1: servizio non installato */
"Battery, limit off" = "Batteria, limite non attivo";
"Turn on charge limit" = "Attiva il limite di ricarica";
"You’ll be asked for your administrator\npassword to turn on the charge limit" = "Ti chiederà la password di amministratore\nper attivare il limite di ricarica";

/* Stato 2: servizio attivo */
"Battery not detected" = "Batteria non rilevata";
"Charging" = "In carica";
"Paused" = "In pausa";
"Not plugged in" = "Alimentatore scollegato";
"Turn off limit" = "Disattiva il limite";
"Quit" = "Esci";
"Quits the app. The limit stays on." = "Chiude l'app; il limite resta attivo";

/* Conferma di disattivazione */
"Turn off the limit?" = "Disattivare il limite?";
"Your battery will charge to 100%." = "La batteria tornerà a caricarsi al 100%.";
"Cancel" = "Annulla";
"Turn off" = "Disattiva";

/* Errori: %@ è il dettaglio restituito dal sistema */
"Couldn’t turn on the limit: %@" = "Attivazione non riuscita: %@";
"Couldn’t turn off the limit: %@" = "Disattivazione non riuscita: %@";
"Couldn’t save the limit: %@" = "Non riesco a salvare la soglia: %@";

/* Stato unico: il limite non può funzionare su questo Mac (DA APPROVARE) */
"Battery, limit unavailable" = "Batteria, limite non disponibile";
"BatteryGuard isn’t available for this Mac yet" = "BatteryGuard non è ancora disponibile per questo Mac";
"Send us a report and we’ll work on a fix." = "Mandaci una segnalazione e lavoreremo a una correzione.";
"Send report" = "Invia segnalazione";
"The full report is on the clipboard: paste it here." = "Il rapporto completo è negli appunti: incollalo qui.";
"No mail app found. The report is on the clipboard: send it to %@." = "Nessuna app di posta trovata. La segnalazione è negli appunti: mandala a %@.";

/* Pannello aperto fuori dalla barra: icona nascosta dietro la tacca */
"Your menu bar is full, so the BatteryGuard icon is hidden behind the camera notch. Hold ⌘ and drag other icons out of the menu bar to make room." = "La barra dei menu è piena e l'icona di BatteryGuard è nascosta dietro la tacca della fotocamera. Tieni premuto ⌘ e trascina fuori altre icone per farle spazio.";

/* VoiceOver: batteria regolabile */
"Battery at %lld%%" = "Batteria al %lld%%";
"Charge limit %lld%%" = "soglia massima %lld%%";
"From %lld to %lld%%. Drag the marker or use the arrow keys to change it." = "Da %lld a %lld%%. Trascina la tacca o usa le frecce per cambiarla";

/* Aggiornamenti dell'app: %@ è la versione nuova */
"Update available: %@" = "Aggiornamento disponibile: %@";
"Update" = "Aggiorna";
"Updating…" = "Aggiornamento in corso…";
"To update from here, move BatteryGuard to Applications and open it again." = "Per aggiornare da qui, sposta BatteryGuard in Applicazioni e riaprila.";
"BatteryGuard can’t replace itself in this folder. Download the new version from batteryguard.alessiocardelli.com." = "BatteryGuard non può sostituirsi in questa cartella. Scarica la nuova versione da batteryguard.alessiocardelli.com.";
"The download didn’t complete. Try again later." = "Il download non è andato a buon fine. Riprova più tardi.";
"The downloaded file doesn’t match its checksum." = "Il file scaricato non corrisponde al suo checksum.";
"The downloaded app didn’t pass the checks." = "L'app scaricata non ha superato i controlli.";
"Couldn’t start the update." = "Non riesco ad avviare l'aggiornamento.";

/* Servizio installato più vecchio dell'app */
"The background service needs an update." = "Il servizio in background va aggiornato.";
"Couldn’t update the service: %@" = "Aggiornamento del servizio non riuscito: %@";
